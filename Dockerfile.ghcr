# syntax=docker/dockerfile:1

FROM node:26-alpine3.24 AS webui

ENV VITE_APP_BASE_URL=""
ENV VITE_APP_BASE_API_URL="/api"

WORKDIR /src/webui
COPY webui/package.json webui/yarn.lock webui/.yarnrc.yml ./
RUN npm i -g corepack@0.36.0 --ignore-scripts && yarn install --immutable
COPY webui/ ./
RUN yarn build

FROM golang:1.27-alpine AS build

ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH

WORKDIR /src
# The module has local replace directives (pkg/config/dynamic/ext, third_party), so the whole tree is needed first.
COPY . .
COPY --from=webui /src/webui/static ./webui/static

RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
    -ldflags "-s -w -X github.com/traefik/traefik/v3/pkg/version.Version=$VERSION" \
    -o /traefik ./cmd/traefik

FROM alpine:3.24

RUN apk add --no-cache --no-progress ca-certificates tzdata

COPY --from=build /traefik /traefik

EXPOSE 80 443 443/udp
VOLUME ["/tmp"]

ENTRYPOINT ["/traefik"]
